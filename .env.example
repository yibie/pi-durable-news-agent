# Copy to .env. `just net up <device>` copies the names in env_keys (dna-network.yaml) to each device.

# Providers
OPENROUTER_API_KEY=            # agents (Haiku 5.5 default) and jev (~typesafe/jev-latest)
OPENAI_API_KEY=                # card images (gpt-image-2.5-flare) when a source has none
FIRECRAWL_API_KEY=             # optional: deep research and hyper_fetch use it when set; sweep search only with DNA_SEARCH_MODE=firecrawl
# TYPESAFE_API_KEY=            # optional: direct jev instead of OpenRouter
# DNA_KEYCHAIN=TYPESAFE_API_KEY=typesafe-api-key   # optional, macOS: fill unset keys from keychain items (VAR=service,
#                                                  # comma separated), so `just net service` runs with them too
# DNA_PROVIDER=deepseek        # optional: agents on DeepSeek's own API (DEEPSEEK_API_KEY) instead of OpenRouter;
#                              # then DNA_MODEL / DNA_RESEARCH_MODEL are deepseek-flash or deepseek-v4-pro
# DEEPSEEK_API_KEY=
# DNA_ANTHROPIC_AUTH=~/.pi/agent/auth.json   # optional: add Claude (claude-opus-5-5 ...) through a pi login to Anthropic;
#                                            # refreshes write back to the file under pi's own lock
# DNA_WRITER_MODEL=claude-opus-5-5           # the writer's model (default: Opus 5.5 with Anthropic, deepseek-v4-pro on
#                                            # DeepSeek, else DNA_MODEL)
# DNA_TWITTER_ENV=~/.config/selfpromotion/twitter.env   # X cookies (TWITTER_AUTH_TOKEN, TWITTER_CT0) for the twitter CLI that
#                                                      # reads X accounts (web_page sources at https://x.com/<handle>)
# DNA_LEDGER_IMPORT=                 # optional: an old jsonl publish ledger to import on start, so spacing sees it
# DNA_PUBLISHED_DIR=                 # optional: archive each published post here as <date>-pick-<id>.md and .png
# DNA_CONFIG_DIR=apps/dna-server-api/config-selfpromotion   # optional: seed sources.json / keywords.json from here
#                                                            # instead of apps/dna-server-api/config (first run only)

# Tokens (write both with: just api tokens)
DNA_CLIENT_TOKEN=
DNA_CRON_TOKEN=

# Runtime
DNA_PORT=4850
DNA_HUB_PORT=4851                # browser hub port for a device with no hub_port in dna-network.yaml
DNA_TARGET=local               # device the browser hub, TUI and CLI talk to
DNA_MODEL=anthropic/claude-haiku-5.5
DNA_RESEARCH_MODEL=anthropic/claude-haiku-5.5
DNA_IMAGE_MODEL=gpt-image-2.5-flare
DNA_IMAGE_QUALITY=low          # low | medium | high
# Search. web (the default, free): Bing News RSS, then Google News RSS when Bing fails or finds nothing, beside
# Hacker News search and the cached feeds; deep research adds Bing web, then DuckDuckGo. An engine that fails rests
# 2 to 30 minutes (dna doctor shows each one). firecrawl: Firecrawl first within the credit caps below, falling back
# to the free engines. fixture: offline test data. Any other value warns and searches the web.
DNA_SEARCH_MODE=web            # web | firecrawl | fixture
DNA_FIRECRAWL_SWEEP_CREDITS=5
DNA_FIRECRAWL_DAILY_CREDITS=40
DNA_SWEEP_QUERIES=15           # topics searched per sweep, a draw weighted by each topic's weight
DNA_MAX_SAVED_SOURCES=25       # cap on sources the agent saves (save_source, upvote leads)
DNA_CRON_SCHEDULE="* * * * *"  # the tick; how often sweeps run and how many cards they present is set in the app

# Local decision model instead of jev (TypeSafe): the Ollama app (0.40.4+) on this Mac serves tev1 on the same API,
# free. Use the 16K variant (deploy/tev1-16k.Modelfile): dedupe rows run past tev1's 2K. Thresholds for it are in
# <config dir>/jev-policy.json under "ollama". A sweep that finds the app closed opens it.
# JEV_BACKEND=ollama
# JEV_MODEL=tev1-16k
# JEV_OLLAMA_URL=http://127.0.0.1:11434/v1/systemone   # only if Ollama listens somewhere else

# Tests only
# DNA_PROVIDER=faux
# JEV_BACKEND=mock
# JEV_LIVE=1
