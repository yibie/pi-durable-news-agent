{
  "manifest_version": 3,
  "name": "工作台发帖桥",
  "version": "0.2.4",
  "description": "Lets the local workbench write and post on x.com in this Chrome.",
  "permissions": ["scripting", "tabs", "alarms"],
  "host_permissions": ["https://x.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" }
}
